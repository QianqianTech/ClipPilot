<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/secondary_disabled_fill" />
            <stroke android:width="1dp" android:color="@color/secondary_disabled_stroke" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_blue_light" />
            <stroke android:width="1dp" android:color="@color/brand_blue" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/card" />
            <stroke android:width="1dp" android:color="@color/secondary_stroke" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>

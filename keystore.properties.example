# Copy to keystore.properties (git-ignored) to sign release builds locally.
# Never commit the real file or the keystore. CI uses RELEASE_STORE_FILE, RELEASE_STORE_PASSWORD,
# RELEASE_KEY_ALIAS and RELEASE_KEY_PASSWORD environment variables instead.
storeFile=release/video-browse-assistant.jks
storePassword=change-me
keyAlias=video-browse-assistant
keyPassword=change-me
